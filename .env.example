# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# NOTHING IN THIS PROJECT REQUIRES A KEY.
#
# The full cascade -- Tier 3 included -- runs from the response cache committed in
# fixtures/llm_cache. `make demo`, `make test` and `make eval` all work offline, and CI
# proves it on every push by running them with no credentials configured. A key is only
# needed to ask the model something it has never been asked before: a new fixture, a new
# seed, or a changed prompt.

# Google AI Studio. Either name works; the adapter reads GEMINI_API_KEY first.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Anthropic. Unused -- AnthropicAdapter is the second implementation of the LLMAdapter
# Protocol and exists as evidence that swapping providers touches one file (ADR-031).
# It is not exercised by any test and has never run.
ANTHROPIC_API_KEY=
